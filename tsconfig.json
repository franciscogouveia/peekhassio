{
    "compilerOptions": {
        "module": "NodeNext",
        "moduleResolution": "NodeNext",
        "target": "ES2023",
        "lib": ["ES2023"],
        "rootDir": "src",
        "outDir": "dist",
        "strict": true,
        "exactOptionalPropertyTypes": true,
        "noUncheckedIndexedAccess": true,
        "noEmitOnError": true,
        "sourceMap": false,
        "declaration": false,
        "skipLibCheck": true
    },
    "include": ["ambient.d.ts", "src/**/*.ts"]
}
